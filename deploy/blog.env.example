# 博客服务环境变量（由 systemd 的 EnvironmentFile 读取）
#
# 安装：把本文件复制到 /etc/blog/blog.env 并设置严格权限：
#   sudo install -d -m 750 /etc/blog
#   sudo install -m 600 -o root -g root deploy/blog.env.example /etc/blog/blog.env
#   sudo nano /etc/blog/blog.env      # 按需调整
#
# 注意：命令行 -flag 的优先级高于环境变量，所以 ExecStart 里不要重复传同一个参数，
# 否则会覆盖这里的设置。

# ---- 初始化表单的预填值 ----
#
# 站点首次启动时处于「未初始化」状态，访问任何页面都会引导到 /init。
# 下面的值只用于**预填**初始化表单，真正生效的是你在页面上提交的内容。
#
# 管理员密码不在环境变量里设置，而是在 /init 页面填写——
# 避免明文密码出现在进程列表（ps）和 systemd 单元文件里。
BLOG_ADMIN_USER=admin

# ---- 人机校验方式：slider（滑块拼图，默认）/ image（字符验证码）/ off（关闭）----
BLOG_CAPTCHA=slider

# ---- 监听地址与数据文件 ----
BLOG_ADDR=127.0.0.1:18080
BLOG_DB=/opt/blog/data/blog.db
BLOG_ABOUT=/opt/blog/content/about.md

# ---- 站点信息（同样只用于预填初始化表单；初始化后请到后台「站点设置」修改）----
BLOG_TITLE=我的博客
BLOG_AUTHOR=站长
BLOG_DESCRIPTION=记录技术与生活
BLOG_BIO=热爱编程，记录思考。
# BLOG_GITHUB=https://github.com/yourname
# BLOG_EMAIL=you@example.com
# BLOG_ICP=京ICP备00000000号
